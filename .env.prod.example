# Production Environment Variables for AgenticSeek
# Copy this file to .env and update with your actual values

# Service URLs (for Docker Compose production deployment)
SEARXNG_BASE_URL="http://searxng:8080"
REDIS_BASE_URL="redis://redis:6379/0"

# Ports
SEARXNG_PORT="8080"
FRONTEND_PORT="3000"
BACKEND_PORT="7777"

# Directory Configuration
# Path to your working directory where AgenticSeek can read/write files
# In production, this should be a persistent volume mount
WORK_DIR="/opt/workspace"

# SearxNG Configuration
# Generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY="change-this-to-a-random-secret-key"

# UWSGI Configuration for SearxNG
UWSGI_WORKERS="4"
UWSGI_THREADS="4"

# LLM Provider Ports (only needed if running local LLM providers)
OLLAMA_PORT="11434"
LM_STUDIO_PORT="1234"
CUSTOM_ADDITIONAL_LLM_PORT="11435"

# API Keys (Optional - Only needed if using cloud LLM providers)
# Leave empty if running LLMs locally
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
HUGGINGFACE_API_KEY=""
DSK_DEEPSEEK_API_KEY=""

# Frontend Configuration
REACT_APP_BACKEND_URL="http://localhost:7777"

# Docker Configuration
# Set to your actual hostname or IP in production
# REACT_APP_BACKEND_URL="https://api.yourdomain.com"
